# Runtime storage. Leave unset for project data/, or use an absolute persistent path.
# DATA_DIR=/absolute/path/to/persistent/data

# Session/authentication. Set strong passwords before the first start; existing
# database users are not overwritten on later restarts.
DASHBOARD_SECRET_KEY=replace-with-a-long-random-secret
DASHBOARD_MANAGEMENT_USERNAME=management
DASHBOARD_MANAGEMENT_PASSWORD=replace-with-a-strong-password
DASHBOARD_STAFF_USERNAME=staff
DASHBOARD_STAFF_PASSWORD=replace-with-a-strong-password
DASHBOARD_SESSION_TIMEOUT_MINUTES=60
# DASHBOARD_COOKIE_SECURE=1

# Optional PM workbook overrides. The defaults are canonical files in DATA_DIR.
# MAINTENANCE_WORKBOOK_PATH=/absolute/path/to/utility_schedule.xlsx
# EQUIPMENT_MAINTENANCE_WORKBOOK_PATH=/absolute/path/to/equipment_schedule.xlsx

# Optional spare-parts source overrides. Imports made in the UI are stored under DATA_DIR.
# SPARE_PARTS_D365_PATH=/absolute/path/to/spare_inventory.xlsx
# SPARE_PARTS_GEN_PO_PATH=/absolute/path/to/gen_po.xlsx
# SPARE_PARTS_PO_STAGE1_PATH=/absolute/path/to/stage_1_gen_po.xlsx
# SPARE_PARTS_PO_STAGE2_PATH=/absolute/path/to/stage_2_gen_po.xlsx
# INDIRECT_PO_PATH=/absolute/path/to/indirect_po.xlsx

# Import/cache behavior.
ASYNC_WORK_ORDER_DB_IMPORT=1
MIRA_CLEAR_CACHE_ON_STARTUP=0
MIRA_WARM_SPARE=0

# Optional local Ollama integration. Rule-based insights work when disabled.
OLLAMA_ENABLED=0
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b

# Server.
PORT=5005
FLASK_DEBUG=0
USE_WAITRESS=1

# Read-only API used by the separate production dashboard. The service token
# authenticates backend-to-backend calls only and must never be sent to a browser.
# Leave blank to auto-enable when a valid service token is set. Set false only
# when an administrator intentionally wants the service API disabled.
MAINTENANCE_API_ENABLED=
MAINTENANCE_API_SERVICE_TOKEN=replace-with-the-shared-service-token
MAINTENANCE_ALLOWED_CALLERS=production-equipment-loading
MAINTENANCE_API_MAX_ASSETS_PER_REQUEST=100
MAINTENANCE_API_MAX_DATE_RANGE_DAYS=730
# Availability window cap (days) for /assets/{id}/availability and /assets/availability.
MAINTENANCE_API_MAX_WINDOW_DAYS=31
